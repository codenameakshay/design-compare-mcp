{
  "name": "design-compare-mcp",
  "version": "0.11.0",
  "description": "MCP server that scores how closely a candidate UI matches a reference design image, and returns a fix punch-list.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node scripts/run-tests.mjs",
    "bench": "worker/.venv/bin/python scripts/benchmark.py",
    "smoke": "node scripts/smoke.mjs",
    "resilience": "node scripts/resilience.mjs",
    "lifecycle": "node scripts/lifecycle.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "puppeteer-core": "^25.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
